POSTGRES_USER=gaya
POSTGRES_PASSWORD=change_me
POSTGRES_DB=gaya
# Host port. The backend container reaches it at host.docker.internal:<port>.
POSTGRES_PORT=5433

# LocalStack (S3). The backend reaches it at http://host.docker.internal:<port>
LOCALSTACK_PORT=4566
S3_BUCKET=gaya-images
# LocalStack accepts any credentials
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
